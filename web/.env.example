# ReplyForge Web Seller Center - Client Environment Configuration (.env.example)
# Copy to .env.local if you need to override defaults.
# All variables are optional; the client includes safe built-in fallbacks
# and runs at http://localhost:5173 with Vite's /api proxy to http://localhost:8088.

VITE_DEV_PORT=5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8088
VITE_STORE_NAME=Stickeria
VITE_DEFAULT_VIEW=studio
VITE_ENABLE_OFFLINE_SIMULATOR=true
