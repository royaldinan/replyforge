# ReplyForge Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials if using an external AI provider.
# Never commit the actual .env file to Git.

PORT=8088
REPLYFORGE_DB=./data/replyforge.db
REPLYFORGE_BASE_URL=http://localhost:20128/v1
REPLYFORGE_API_KEY=your_api_key_here
REPLYFORGE_MODEL=ag/gemini-3.8-flash-low
