<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan Toko &amp; AI"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Store Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informasi Toko"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nama Toko"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_set_store_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rekening Pembayaran (WhatsApp)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_set_bank_account"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Batas Jam Kirim / Cutoff"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_set_cutoff"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kota Asal Pengiriman Toko"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_set_city"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:hint="cth: Bandung / Jakarta / Surabaya"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kunci API AI (opsional — kosong = mesin lokal 100% offline)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_set_api_key"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:hint="Tempel API key di sini (tidak disimpan di repo)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_settings"
                style="@style/Widget.ReplyForge.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="Simpan Pengaturan Toko"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Actions / Reset Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manajemen Data Toko"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_tutorial"
                style="@style/Widget.ReplyForge.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="📖 Buka Panduan &amp; Tutorial Penggunaan"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reload_demo"
                style="@style/Widget.ReplyForge.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="⚡ Muat Ulang Profil &amp; Katalog Demo Stickeria"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_all_data"
                style="@style/Widget.ReplyForge.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="Hapus Semua Riwayat Pesanan &amp; Chat"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_self_test"
                style="@style/Widget.ReplyForge.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="@string/self_test_open_button"
                android:textColor="@color/surface_card"
                android:textSize="13sp"
                android:textStyle="bold" />

            <view
                class="id.replyforge.agent.SelfTestActivity$SettingsLaunchBinder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
