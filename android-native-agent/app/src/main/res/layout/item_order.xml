<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_white"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RF-261113-4338"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_amber"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Menunggu Bayar"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_buyer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Ferdinand Manurung · WhatsApp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp15.000"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_order_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_stepper"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="8dp"
        android:text="1x Paket Stiker Kucing Gemoy Vinyl Waterproof"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- Action buttons row -->
    <LinearLayout
        android:id="@+id/ll_order_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_order_item_paid"
            style="@style/Widget.ReplyForge.Button.Success"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="✓ Konfirmasi Lunas"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_order_item_cancel"
            style="@style/Widget.ReplyForge.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="✕ Batalkan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
